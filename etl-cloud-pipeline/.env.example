# Local extraction source CSV data file path
CSV_PATH=data/dummy_data.csv

# Local relational storage SQLite target database file path
DB_PATH=data/etl.db

# Extraction source switch: true to read from Azure SQL Server, false to read local CSV
READ_FROM_AZURE_SQL=false

# Azure SQL Server hostname or cluster endpoint address
AZURE_SQL_SERVER=enterprise-cluster.database.windows.net

# Name of the target database hosted on Azure SQL Server
AZURE_SQL_DATABASE=sales_db

# Administrative or service username for Azure SQL authentication
AZURE_SQL_USERNAME=cloud_admin

# User secret password for Azure SQL authentication
AZURE_SQL_PASSWORD=YourSecretPasswordHere123!

# Installed system ODBC driver name for SQL Server connection
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Cloud storage upload switch: true to stream dataset to Azure Blob Storage
UPLOAD_TO_AZURE=false

# Azure Blob Storage Account connection string
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey==;EndpointSuffix=core.windows.net

# Destination container name in Azure Blob Storage
AZURE_CONTAINER_NAME=etl-reports

# Email distribution switch: true to send automated report email to recipient
SEND_EMAIL=false

# Stakeholder target email recipient for report delivery
RECIPIENT_EMAIL=stakeholder@example.com

# Authenticated sender email account for SMTP relay connection
SMTP_USER=developer-alerts@gmail.com

# Authenticated SMTP password or 16-character Gmail App Password
SMTP_PASS=abcd efgh ijkl mnop

# Hostname of the SMTP relay server
SMTP_SERVER=smtp.gmail.com

# Port number for TLS encrypted SMTP connection
SMTP_PORT=587
